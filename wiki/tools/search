#!/usr/bin/env bash
# Search wiki pages: wiki/tools/search <query> [--type T] [--tag T] [--limit N] [--json]
# Run `wiki/tools/search --help` for details. Arguments go after `--` so that
# `dotnet run` does not interpret options such as --help itself.
exec dotnet run --file "$(dirname "$0")/wikitool" -- search "$@"
